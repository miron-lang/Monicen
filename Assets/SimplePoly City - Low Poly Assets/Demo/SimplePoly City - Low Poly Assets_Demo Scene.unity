  - "\u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435 \u0424\u0440\u0435\u043D\u043A\u0430
    \u0432 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u043E\u043C \u0443\u0447\u044F\u0441\u0442\u043A\u0435."
  - "\u041A\u0443\u043F\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u0432
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435"
  - "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0413\u0430\u043D\u0441\u0442\u0430\u043B\u0438\u0441\u0430
    \u0438 \u043E\u0442\u043E\u043C\u0441\u0442\u0438\u0442\u0435 \u0435\u043C\u0443."
  - "\u0412\u0441\u0435 \u043C\u0438\u0441\u0441\u0438\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B
